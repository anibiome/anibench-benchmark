{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anibench.org/schemas/v2/conditional-posterior-reference.schema.json",
  "title": "Conditional Gaussian posterior-reference diagnostic v1",
  "description": "Illustrative model-conditional geometry; not certified biological saturation. SPDX-License-Identifier: CC-BY-4.0; SPDX-FileCopyrightText: 2026 ANI",
  "type": "object",
  "required": [
    "contract",
    "claim_class",
    "worst_direction_posterior_variance_ratio",
    "all_direction_reference_attainment",
    "numerical_tolerance",
    "comparison_rule",
    "public_saturation_claim_allowed",
    "promotion_allowed"
  ],
  "properties": {
    "contract": {
      "const": "anibench.conditional-posterior-reference.v1"
    },
    "claim_class": {
      "const": "conditional_gaussian_geometry_not_biological_saturation"
    },
    "worst_direction_posterior_variance_ratio": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "all_direction_reference_attainment": {
      "type": "boolean"
    },
    "numerical_tolerance": {
      "const": 1e-10
    },
    "comparison_rule": {
      "const": "worst_direction_posterior_variance_ratio <= 1 + numerical_tolerance"
    },
    "public_saturation_claim_allowed": {
      "const": false
    },
    "promotion_allowed": {
      "const": false
    }
  },
  "additionalProperties": false
}

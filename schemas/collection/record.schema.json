{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anibench.org/schemas/collection/record.schema.json",
  "title": "AniBench private collection record",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "anibench.collection-record.v1"
    },
    "study_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "record_basis": {
      "enum": [
        "planned",
        "collected"
      ]
    },
    "inventory_status": {
      "enum": [
        "complete",
        "partial"
      ]
    },
    "participant_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "properties": {
          "module_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "domain": {
            "enum": [
              "molecular",
              "microbial",
              "physiological",
              "functional",
              "cognitive",
              "neural",
              "psychological",
              "digital",
              "exposure_context"
            ]
          },
          "target_unit": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "target_definition_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "target_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "uniqueItems": true
          }
        },
        "required": [
          "module_id",
          "domain",
          "target_unit",
          "target_definition_id",
          "target_ids"
        ],
        "additionalProperties": false
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "participant_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "event_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "time_days": {
            "type": [
              "number",
              "null"
            ]
          }
        },
        "required": [
          "participant_id",
          "event_id",
          "time_days"
        ],
        "additionalProperties": false
      }
    },
    "acquisitions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "acquisition_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "participant_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "event_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "module_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "target_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "uniqueItems": true
          },
          "quality_status": {
            "enum": [
              "pass",
              "fail",
              "unknown",
              "planned"
            ]
          },
          "source_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "target_set_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          }
        },
        "required": [
          "acquisition_id",
          "participant_id",
          "event_id",
          "module_id",
          "quality_status",
          "source_sha256"
        ],
        "additionalProperties": false,
        "oneOf": [
          {
            "required": [
              "target_ids"
            ],
            "not": {
              "required": [
                "target_set_id"
              ]
            }
          },
          {
            "required": [
              "target_set_id"
            ],
            "not": {
              "required": [
                "target_ids"
              ]
            }
          }
        ]
      }
    },
    "time_resolution_days": {
      "type": "number",
      "minimum": 0
    },
    "target_sets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "target_set_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "module_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "target_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "uniqueItems": true
          }
        },
        "required": [
          "target_set_id",
          "module_id",
          "target_ids"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "study_id",
    "record_basis",
    "inventory_status",
    "participant_ids",
    "modules",
    "events",
    "acquisitions",
    "time_resolution_days"
  ],
  "additionalProperties": false
}

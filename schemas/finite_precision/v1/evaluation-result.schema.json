{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anibench.org/schemas/finite_precision/v1/evaluation-result.schema.json",
  "$comment": "SPDX-FileCopyrightText: 2026 ANI; SPDX-License-Identifier: CC-BY-4.0",
  "type": "object",
  "required": [
    "contract",
    "task_id",
    "task_version",
    "task_sha256",
    "request_sha256",
    "claim_lane",
    "claim_scope",
    "comparison_scope",
    "attainment",
    "support",
    "checks",
    "functionals",
    "numerical_relative_tolerance",
    "evidence_verification",
    "all_direction_attainment",
    "empirical_learning_plateau",
    "public_saturation_claim_allowed",
    "promotion_allowed",
    "implementation"
  ],
  "properties": {
    "contract": {
      "const": "anibench.finite-task-precision.v1"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "task_version": {
      "type": "string",
      "minLength": 1
    },
    "task_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "request_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "claim_lane": {
      "enum": [
        "conditional_design",
        "realized_record"
      ]
    },
    "claim_scope": {
      "const": "conditional_gaussian_finite_functionals_not_biological_calibration"
    },
    "comparison_scope": {
      "const": "finite_functionals_only"
    },
    "attainment": {
      "enum": [
        "attained",
        "not_attained",
        "unknown"
      ]
    },
    "support": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "domain_id",
          "role",
          "state"
        ],
        "properties": {
          "domain_id": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "enum": [
              "observation",
              "perturbation"
            ]
          },
          "state": {
            "enum": [
              "attained",
              "not_attained",
              "unknown"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "checks": {
      "type": "object",
      "required": [
        "identifiability"
      ],
      "properties": {
        "identifiability": {
          "enum": [
            "attained",
            "not_attained",
            "unknown"
          ]
        },
        "collection_verified": {
          "enum": [
            "attained",
            "not_attained",
            "unknown"
          ]
        }
      },
      "additionalProperties": false
    },
    "functionals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "functional_id",
          "unit",
          "posterior_variance",
          "variance_limit",
          "state",
          "prior_variance",
          "prior_only_precision_attainment",
          "variance_reduction"
        ],
        "properties": {
          "functional_id": {
            "type": "string",
            "minLength": 1
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "posterior_variance": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "number",
                "exclusiveMinimum": 0
              }
            ]
          },
          "variance_limit": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "state": {
            "enum": [
              "attained",
              "not_attained",
              "unknown"
            ]
          },
          "prior_variance": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "prior_only_precision_attainment": {
            "type": "boolean"
          },
          "variance_reduction": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "number",
                "minimum": 0
              }
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "numerical_relative_tolerance": {
      "const": 1e-10
    },
    "evidence_verification": {
      "const": "caller_declared_not_independently_certified"
    },
    "all_direction_attainment": {
      "type": "null"
    },
    "empirical_learning_plateau": {
      "type": "null"
    },
    "public_saturation_claim_allowed": {
      "const": false
    },
    "promotion_allowed": {
      "const": false
    },
    "implementation": {
      "type": "object",
      "required": [
        "contract",
        "sha256",
        "python_version",
        "numpy_version",
        "jsonschema_version"
      ],
      "additionalProperties": false,
      "properties": {
        "contract": {
          "const": "anibench.finite-task-implementation.v1"
        },
        "sha256": {
          "type": "object",
          "required": [
            "finite_tasks_v1.py",
            "information_v2.py",
            "evaluation-input.schema.json",
            "evaluation-result.schema.json"
          ],
          "additionalProperties": false,
          "properties": {
            "finite_tasks_v1.py": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "information_v2.py": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "evaluation-input.schema.json": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "evaluation-result.schema.json": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        },
        "python_version": {
          "type": "string",
          "minLength": 1
        },
        "numpy_version": {
          "type": "string",
          "minLength": 1
        },
        "jsonschema_version": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "additionalProperties": false
}
